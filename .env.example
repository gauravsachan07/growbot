# Copy to .env and fill in. NEVER commit the real .env (it is gitignored).
# Loaded by src/growbot/config.py at import time, before any other env read.
#
# !! This file IS committed and shared with classmates. Never put a real key
# !! here - the real key goes in .env only. `python -m growbot.generate.checks`
# !! fails if a key-shaped string ever appears in a file like this one.

# --- LLM (Phase 7 - generation) -------------------------------------------
# Any OpenAI-compatible provider works. Set LLM_PROVIDER to pick a default
# base URL, or set LLM_BASE_URL yourself for anything not in the list.
#   LLM_PROVIDER: openai | groq | openrouter | gemini
# A free tier is enough for a class demo. LLM_MODEL is the provider's model id.
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-3.8-flash
# Only needed for a provider not in the list above:
# LLM_BASE_URL=

# Reliability. Free tiers are flaky - gemini-3.8-flash was measured returning
# HTTP 503 "high demand" on roughly half of all calls - so a single attempt
# makes the bot look broken during a demo. LLM_MAX_ATTEMPTS is the total number
# of tries; the wait between them doubles and is jittered.
# LLM_MAX_ATTEMPTS=4
# LLM_RETRY_BACKOFF=1.5
# LLM_MAX_TOKENS=800

# --- Embeddings / vector store (Phase 3) ---------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
COLLECTION_NAME=hdfc_mf_faq
CHROMA_PATH=data/chroma

# Which runtime executes the encoder. Measured peak RSS for one ask():
#   onnx  238.7 MB   onnxruntime, torch never imported (default)
#   torch 579.7 MB   sentence-transformers
# Same weights, same vector - cosine 1.0000000000, max elementwise 1.6e-07 - so
# this needs no re-ingest, and growbot.retrieve.checks re-measures that on every
# run. Leave it commented to stay on onnx; set torch to fall back to
# sentence-transformers. Note chroma's onnx encoder implements all-MiniLM-L6-v2
# only, so a custom EMBEDDING_MODEL with onnx falls back to torch automatically.
# EMBEDDING_BACKEND=onnx

# --- Retrieval tuning (Phases 6/11) --------------------------------------
# These are the Phase 6 *measured* values. Leaving them commented out uses the
# same numbers from config.py, so there is one source of truth. Setting them
# here overrides the measurement - only do that deliberately.
# TOP_K=5
# SIMILARITY_FLOOR=0.45
# Prior question turns usable for resolving an underspecified follow-up to a
# fund. Set to 0 to switch conversation memory off entirely. See growbot/memory.py.
# MEMORY_TURNS=10

# --- Corpus ---------------------------------------------------------------
SOURCES_CSV=data/sources.csv
